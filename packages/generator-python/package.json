{
  "name": "@modelforge/generator-python",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && python -m py_compile ../../fixtures/python-compile/dataclass_models.py ../../fixtures/python-compile/pydantic_models.py",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelforge/core": "workspace:*"
  },
  "devDependencies": {
    "@modelforge/parser-json": "workspace:*"
  }
}
