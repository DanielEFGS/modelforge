{
  "name": "@modelforge/generator-typescript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p ../../fixtures/typescript-compile/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelforge/core": "workspace:*"
  },
  "devDependencies": {
    "@modelforge/parser-json": "workspace:*"
  }
}
