---
import { getLegalDocument, type LegalKind } from '../lib/legal-i18n';

interface Props {
  kind: LegalKind;
}

const { kind } = Astro.props;
const content = getLegalDocument(kind, 'en');
---

<main class="legal" data-legal-kind={kind}>
  <span data-legal-eyebrow>{content.eyebrow}</span><h1 data-legal-title>
    {content.title}
  </h1><p class="updated" data-legal-status>{content.status}</p>
  {
    content.sections.map((section, index) => (
      <section>
        <h2 data-legal-heading={index}>{section.heading}</h2>
        <p data-legal-body={index}>{section.body}</p>
      </section>
    ))
  }
</main>

<script>
  import { isLocale, resolveLocale, type Locale } from '../lib/i18n';
  import { getLegalDocument, type LegalKind } from '../lib/legal-i18n';

  function applyLegalLocale(locale: Locale) {
    document
      .querySelectorAll<HTMLElement>('[data-legal-kind]')
      .forEach((page) => {
        const kind = page.dataset.legalKind as LegalKind;
        const content = getLegalDocument(kind, locale);
        const setText = (selector: string, value: string) => {
          const node = page.querySelector(selector);
          if (node) node.textContent = value;
        };
        setText('[data-legal-eyebrow]', content.eyebrow);
        setText('[data-legal-title]', content.title);
        setText('[data-legal-status]', content.status);
        content.sections.forEach((section, index) => {
          setText(`[data-legal-heading="${index}"]`, section.heading);
          setText(`[data-legal-body="${index}"]`, section.body);
        });
        document.title = `${content.title} | ModelForge`;
      });
  }

  const storedLocale = localStorage.getItem('modelforge-locale');
  applyLegalLocale(
    isLocale(storedLocale)
      ? storedLocale
      : resolveLocale(globalThis.navigator.languages),
  );
  globalThis.addEventListener('modelforge:locale-change', (event) => {
    const locale = (event as CustomEvent<Locale>).detail;
    if (isLocale(locale)) applyLegalLocale(locale);
  });
</script>

<style>
  .legal {
    width: min(calc(100% - 2rem), 52rem);
    margin: 4rem auto 6rem;
  }
  .legal > span {
    color: var(--route-primary);
    font: 700 0.7rem var(--font-code);
    letter-spacing: 0.1em;
  }
  h1,
  h2 {
    color: var(--ink-strong);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0.5rem 0;
  }
  h2 {
    margin-top: 2rem;
  }
  p,
  li {
    color: var(--ink-muted);
    line-height: 1.7;
  }
  .updated {
    font: 0.7rem var(--font-code);
  }
</style>
